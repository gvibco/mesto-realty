{
  "name": "mesto-realty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "dev": "node --watch server/index.js",
    "start": "npm run db:migrate && node server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test tests/validation.test.js tests/ui-security.test.js tests/navigation-ui.test.js tests/pricing-ui.test.js tests/assistant.test.js tests/catalog-assistant.test.js tests/seed-media.test.js tests/room-model-ui.test.js tests/room-models.test.js tests/architectural-geometry.test.js tests/architectural-schema.test.js tests/architectural-analysis.test.js",
    "test:api": "node --test --test-concurrency=1 tests/migration.test.js tests/api.test.js tests/production.test.js tests/seed-recovery.test.js tests/room-models-api.test.js tests/architectural-api.test.js",
    "test:browser": "node --test tests/browser.test.js",
    "format:check": "prettier --check public server scripts tests",
    "build:room-viewer": "node scripts/build-room-viewer.js",
    "test:room-browser": "node --test tests/architectural-browser.test.js",
    "build:architecture-viewer": "node scripts/build-architectural-viewer.js",
    "test:architecture": "node --test tests/architectural-schema.test.js tests/architectural-analysis.test.js tests/architectural-geometry.test.js",
    "test:architecture-browser": "node --test tests/architectural-browser.test.js"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "0.4.7",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "three": "0.170.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
