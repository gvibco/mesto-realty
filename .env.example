NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://mesto:CHANGE_ME@localhost:54329/mesto
POSTGRES_USER=mesto
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mesto
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
UPLOAD_DIR=./uploads

# Automatic room reconstruction: same random 32+ character token on site and GPU worker.
# Empty token disables processing and shows setup status only to the property owner.
ROOM_MODEL_WORKER_TOKEN=
ROOM_MODEL_MIN_PHOTOS=20
ROOM_MODEL_DEBOUNCE_SECONDS=60
# Set only behind your own HTTPS reverse proxy. Number of trusted proxy hops.
TRUST_PROXY=0
# AI assistant: server-only key and an explicitly selected tool-capable model.
# OpenAI: leave AI_PROVIDER empty (auto-detected) and keep the default base URL.
# GigaChat: AI_PROVIDER=gigachat, AI_BASE_URL=https://api.giga.chat/v1,
# AI_API_KEY=<authorization key>, AI_MODEL=GigaChat-2, AI_SCOPE=GIGACHAT_API_PERS.
# For local GigaChat runs set NODE_EXTRA_CA_CERTS=./certs/russian-trusted.pem
# in the shell before starting Node.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=
AI_SCOPE=GIGACHAT_API_PERS
AI_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional: used only when creating demo users with npm run db:seed.
DEMO_PASSWORD=
# Email администратора (владелец этого аккаунта получает доступ к /admin)
ADMIN_EMAIL=
# Separate disposable database; never point tests at production.
TEST_DATABASE_URL=postgresql://mesto:CHANGE_ME@localhost:54329/mesto_test
